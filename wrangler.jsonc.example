{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "semantic-context-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"SIGNET_ISSUER": "YOUR_SIGNET_DEV_ISSUER_URL_HERE",
		// Must be a full HTTPS URL, not a bare identifier — mcp-remote parses this via
		// `new URL(resource).href`, which requires a real URL and normalizes in a trailing
		// slash. Use that exact normalized form here too, or client discovery breaks silently.
		// See docs/lessons-learned.md, 2026-08-05, items 1-2, in the Signet repo.
		"MCP_RESOURCE_IDENTIFIER": "https://YOUR_RESOURCE_SERVER_DOMAIN_HERE/"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mcp-context",
			"database_id": "YOUR_DATABASE_ID_HERE"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "YOUR_VECTORIZE_INDEX_NAME_HERE"
		}
	],
	"observability": {
		"enabled": true
	},
	// Scheduled cron: refresh stale Layer 3 predictions every 6 hours
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	"env": {
		"staging": {
			"vars": {
				"SIGNET_ISSUER": "YOUR_SIGNET_STAGING_ISSUER_URL_HERE",
				"MCP_RESOURCE_IDENTIFIER": "https://YOUR_RESOURCE_SERVER_DOMAIN_HERE/"
			}
		},
		"production": {
			"vars": {
				"SIGNET_ISSUER": "YOUR_SIGNET_PRODUCTION_ISSUER_URL_HERE",
				"MCP_RESOURCE_IDENTIFIER": "https://YOUR_RESOURCE_SERVER_DOMAIN_HERE/"
			}
		}
	}
}
